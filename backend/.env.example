DATABASE_URL=postgresql://user:password@localhost:5432/mydb
PORT=8000
JWT_SECRET=cambiame-en-produccion
# Broker (IOL)
SECRET_KEY=otra-clave-larga-y-aleatoria
CORS_ORIGINS=http://localhost:3000
# 1 = se puede operar fuera del horario de mercado (demo)
MERCADO_SIEMPRE_ABIERTO=0
# 1 = precios reales de BYMA (data912.com) cada PRECIOS_INTERVALO segundos
PRECIOS_REALES=0
PRECIOS_INTERVALO=60

# Correo para los códigos de verificación y las alertas (si falta SMTP_HOST, se escriben en la consola)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Zeno Investments <tu.cuenta@gmail.com>
# 0 = no consultar el DNS ni el servidor de correo al validar emails (sin internet o en tests)
VALIDAR_EMAIL_DNS=1
# 0 = las cuentas nuevas quedan confirmadas sin código (solo para pruebas)
VERIFICAR_EMAIL=1

# Cuenta de administrador que crea el seeder (opcional; si falta, se crea una de ejemplo con clave al azar)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NOMBRE=Administración
ADMIN_CUIT=30711111111

# Agente de inversiones Zeno AI (clave gratis en https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Opcional: otro servidor compatible con la API de Groq (por ejemplo uno simulado para probar)
GROQ_URL=
